# GEMINI_API_KEY: Not required unless optional server-side AI features are added later.
# APP_URL: The URL where this applet is hosted (injected by Cloud Run / AI Studio).
APP_URL="MY_APP_URL"

# VITE_GOOGLE_MAPS_API_KEY: Google Maps Platform API key for Maps JS API & Advanced Markers.
# Restrict key by HTTP referrers and Maps JavaScript API in Google Cloud Console.
VITE_GOOGLE_MAPS_API_KEY="MY_GOOGLE_MAPS_API_KEY"

# PORT: Server listening port (defaults to 3000; Cloud Run injects PORT=8080 or 3000).
PORT=3000
